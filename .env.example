# ===== 必填 =====

# LLM 配置（生产用 DeepSeek，开发可用 Ollama）
# DeepSeek: 在 https://platform.deepseek.com 申请，填 sk- 开头
LLM_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# Agent execution budget
AGENT_MAX_STEPS=4
AGENT_MAX_DURATION_SECONDS=75
AGENT_LLM_TIMEOUT_SECONDS=15
AGENT_LLM_MAX_RETRIES=0
AGENT_TOOL_LLM_TIMEOUT_SECONDS=12
AGENT_REQUEST_TIMEOUT_SECONDS=80
LLM_API_KEY=sk-你的deepseek密钥

# JWT 签名密钥（至少 32 字符，禁止用默认值）
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=请替换为随机生成的64位hex字符串

# ===== 可选（有默认值） =====

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=code_assistant

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 检索结果缓存过期时间（秒）
REDIS_CACHE_TTL=300

# Chroma 持久化路径
CHROMA_PERSIST_DIR=./data/chroma

# 要索引的代码仓库路径
REPO_PATH=./data/target_repo

# 当前项目源码知识库路径；Docker Compose 会覆盖为只读挂载目录
PROJECT_SOURCE_PATH=.

# 分块策略: recursive / token / semantic
CHUNK_STRATEGY=recursive

# ===== 本地开发（可选） =====
# 用 Ollama 本地模型时切换：
# LLM_API_ENDPOINT=http://localhost:11434/api/chat
# LLM_MODEL=gemma:7b
